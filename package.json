{
  "name": "crawler-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test:logging": "node --import tsx --test tests/logging.test.ts tests/api-logging.test.ts",
    "test": "node --import tsx --test tests/logging.test.ts tests/api-logging.test.ts tests/discovery.test.ts tests/site-manager.test.ts",
    "setup:browser": "playwright install chromium",
    "start": "tsx src/server/index.ts",
    "run:generated": "node --import dotenv/config --import tsx generated/crawler.ts",
    "verify:generated": "node --import dotenv/config --import tsx generated/crawler.ts --verify",
    "run:all": "node --import dotenv/config --import tsx generated/crawler.ts --all"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Generate standalone news crawlers with the Codex SDK.",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@openai/codex-sdk": "^0.151.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
