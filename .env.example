CODEX_API_KEY=
OPENAI_API_KEY=
# Optional. For example: gpt-5.6-sol. Leave blank to use your local Codex default.
CODEX_MODEL=
# Optional: minimal, low, medium, high, xhigh, max, ultra, or persistent.
CODEX_REASONING_EFFORT=medium
DATABASE_URL=postgresql://crawler:crawler@localhost:5432/crawler_generator
REDIS_URL=redis://localhost:6379
PORT=8787
# Log paths are relative to this project. Each run gets a separate JSONL file.
LOG_DIR=logs
# Maximum duration of generation, in milliseconds (default: 10 minutes).
GENERATION_TIMEOUT_MS=600000
# Wait for delayed XHR/fetch responses in the isolated browser (milliseconds).
BROWSER_WAIT_MS=15000
# Optional: use an installed browser channel, e.g. msedge or chrome.
PLAYWRIGHT_CHANNEL=
